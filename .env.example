# Django Settings
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,capyvagas.example.com
DOMAIN=capyvagas.example.com

# Database Configuration (PostgreSQL)
POSTGRES_DB=capyvagas
POSTGRES_USER=capyvagas_user
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Note: POSTGRES_PASSWORD is read from /run/secrets/postgres_password

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# WAHA Configuration
WAHA_URL=http://waha:3000
WAHA_SESSION_NAME=default
WAHA_TIMEOUT_SECONDS=5
WAHA_API_KEY=sua_api_key_aqui

# WAHA Dashboard Credentials
WAHA_DASHBOARD_USERNAME=seu_usuario_aqui
WAHA_DASHBOARD_PASSWORD=sua_senha_aqui

# WAHA Swagger Credentials
WHATSAPP_SWAGGER_USERNAME=swagger
WHATSAPP_SWAGGER_PASSWORD=sua_senha_aqui

# Bot Dashboard Credentials
BOT_DASHBOARD_USERNAME=seu_usuario_aqui
BOT_DASHBOARD_PASSWORD=sua_senha_aqui

# Django Admin Credentials (for initial superuser creation)
DJANGO_ADMIN_USERNAME=seu_usuario_aqui
DJANGO_ADMIN_PASSWORD=sua_senha_aqui

# Email Configuration
# Development: use console backend (prints to terminal)
# Production: use SMTP backend with AWS SES
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_smtp_username_aqui
# Note: EMAIL_HOST_PASSWORD is read from /run/secrets/email_password in production
DEFAULT_FROM_EMAIL=noreply@capyvagas.utfpr.edu.br

# AWS Configuration
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
AWS_DEFAULT_REGION=us-east-1

# Note: Sensitive secrets (SECRET_KEY, passwords, API keys) should be stored in the secrets/ directory
# See secrets/README.md for instructions on how to set them up
