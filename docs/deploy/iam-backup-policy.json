{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IterbotBackupS3",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::iterbot-backups",
        "arn:aws:s3:::iterbot-backups/*"
      ]
    }
  ]
}
