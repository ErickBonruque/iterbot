# ============================================================================
# IterBot - Production Environment Variables (EC2)
# ============================================================================
# Copie para .env e preencha com valores reais antes do deploy.
# NUNCA commite o arquivo .env com valores reais!
# ============================================================================

# Django Settings
DEBUG=False
ALLOWED_HOSTS=${DOMAIN},www.${DOMAIN},waha.${DOMAIN},backend
DOMAIN=54-123-45-67.sslip.io
PORTAL_BASE_URL=https://${DOMAIN}

# Database Configuration (PostgreSQL)
POSTGRES_DB=capyvagas
POSTGRES_USER=capyvagas_user
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# WAHA Configuration
WAHA_URL=http://waha:3000
WAHA_SESSION_NAME=default
WAHA_TIMEOUT_SECONDS=5
WAHA_API_KEY=substituir_pela_api_key_real
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=substituir_pela_senha_real
WHATSAPP_SWAGGER_USERNAME=swagger
WHATSAPP_SWAGGER_PASSWORD=substituir_pela_senha_real

# Bot Dashboard Credentials
BOT_DASHBOARD_USERNAME=admin
BOT_DASHBOARD_PASSWORD=substituir_pela_senha_real

# Django Admin
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=substituir_pela_senha_real

# Email Configuration (AWS SES - SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=substituir_pelo_smtp_username_ses
DEFAULT_FROM_EMAIL=bonrqueruck@gmail.com

# Backup S3 Configuration
S3_BACKUP_BUCKET=iterbot-utfpr-backups
S3_BACKUP_PREFIX=daily

# Security: Secrets sao lidos de ./secrets/*.txt
# Veja: deployment/scripts/setup_secrets.sh

# BasicAuth (Traefik) — WAHA Dashboard and Django Admin portal
# These credentials are used by setup-htpasswd.sh to generate htpasswd files
# for Traefik's BasicAuth middleware on protected routes.
# WAHA_DASHBOARD_USERNAME and WAHA_DASHBOARD_PASSWORD above are reused here.
# DJANGO_ADMIN_USERNAME and DJANGO_ADMIN_PASSWORD above are reused here.
# Run: ./deployment/scripts/setup-htpasswd.sh
